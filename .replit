modules = ["python-3.11"]
run = ["sh", "-c", "uv run uvicorn backend.main:app --app-dir src --host 0.0.0.0 --port 8000"]

[nix]
channel = "stable-25_05"
packages = ["nodejs_24"]

[agent]
expertMode = true

[packager]
language = "python3-uv"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd src/frontend && npx --yes pnpm@11.25.0 install --frozen-lockfile && npx --yes pnpm@11.25.0 build && cd ../.. && uv sync --frozen --no-dev"]
run = ["sh", "-c", "uv run --no-sync uvicorn backend.main:app --app-dir src --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80
